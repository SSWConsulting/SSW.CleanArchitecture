<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>037AC246-398C-4216-BB3A-9324FA8E9F40</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire.Hosting.AppHost supplies the AppHost build targets and Aspire.Hosting.Dotnet
         supplies AddDotnetProject; the AppHost is a plain Microsoft.NET.Sdk project. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" />
    <PackageReference Include="Aspire.Hosting.Azure.AppService" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <!-- WebApi and MigrationService are registered by path with AddDotnetProject, which builds
       them itself, so the AppHost holds no ProjectReference to either. -->

</Project>
